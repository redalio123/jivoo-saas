{
  "name": "jivoo-saas",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:pos\" \"npm:dev:dashboard\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:pos": "npm --workspace apps/pos run dev",
    "dev:dashboard": "npm --workspace apps/dashboard run dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.15.0",
    "tsx": "^4.19.4"
  }
}