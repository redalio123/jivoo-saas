generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  STAFF
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
  VOID
  REFUNDED
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  DEBIT
  NON_CASH
  DEPOSIT
  COMPLIMENT
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  outlets   Outlet[]
  users     User[]
  products  Product[]
  customers Customer[]
  orders    Order[]
}

model Outlet {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  address     String?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSessions CashSession[]
  employees   Employee[]
  orders      Order[]
  inventory   Inventory[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String   @unique
  pin          String?
  passwordHash String?
  role         UserRole @default(CASHIER)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     Employee?
}

model Employee {
  id        String   @id @default(cuid())
  userId    String   @unique
  outletId  String
  nickname  String?
  phone     String?
  address   String?
  bankAccount String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id])
}

model Category {
  id       String    @id @default(cuid())
  tenantId String
  name     String
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  tenantId    String
  categoryId  String?
  sku         String      @unique
  name        String
  price       Int
  cost        Int         @default(0)
  stock       Int         @default(0)
  minStock    Int         @default(0)
  image       String?
  active      Boolean     @default(true)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id])
  inventories Inventory[]
  orderItems OrderItem[]
}

model Inventory {
  id        String   @id @default(cuid())
  outletId  String
  productId String
  quantity  Int      @default(0)
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([outletId, productId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  instagram String?
  points    Int      @default(0)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model CashSession {
  id          String   @id @default(cuid())
  outletId    String
  openedById  String
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  openingCash Int
  closingCash Int?
  status      String   @default("OPEN")
  outlet      Outlet   @relation(fields: [outletId], references: [id])
}

model Order {
  id            String        @id @default(cuid())
  tenantId      String
  outletId      String
  customerId    String?
  cashierId     String?
  invoiceNumber String        @unique
  status        OrderStatus   @default(DRAFT)
  subtotal      Int
  discount      Int           @default(0)
  total         Int
  paymentMethod PaymentMethod?
  paidAmount    Int            @default(0)
  changeAmount  Int            @default(0)
  orderType     String?
  note          String?
  createdAt     DateTime      @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  outlet        Outlet        @relation(fields: [outletId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  payments      Payment[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId  String
  productId String
  quantity  Int
  price     Int
  subtotal  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  method    PaymentMethod
  amount    Int
  reference String?
  createdAt DateTime @default(now())
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
